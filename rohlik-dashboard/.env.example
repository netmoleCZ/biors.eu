# Copy this file to .env and fill in your Rohlik.cz session cookie.
#
# How to get it:
#   1. Log into https://www.rohlik.cz in your browser.
#   2. Open DevTools (F12) -> Network tab, reload the page.
#   3. Click any request going to www.rohlik.cz.
#   4. In "Request Headers", copy the entire value of the "Cookie" header.
#   5. Paste it below as one line, quoted.
#
# This cookie is your login session - treat it like a password. Never commit
# your real .env file (it's already in .gitignore).

ROHLIK_COOKIE="paste-your-cookie-header-value-here"
